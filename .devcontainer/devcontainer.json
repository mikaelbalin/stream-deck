{
  "name": "stream-deck",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": ["--name", "stream-deck"],
  "remoteUser": "dev",
  "containerEnv": {
    "SHELL": "/usr/bin/fish"
  },
  "customizations": {
    "zed": {
      "extensions": ["rust", "typescript"]
    },
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "tauri-apps.tauri-vscode"
      ]
    }
  },
  "postCreateCommand": "rustc --version && cargo --version && node --version && npm --version && pnpm --version && fish --version"
}
